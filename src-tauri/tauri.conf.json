{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TeXKey",
  "version": "0.3.3",
  "identifier": "app.texkey.converter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TeXKey",
        "width": 1020,
        "height": 700,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Convert Beamer and PDF presentations to Keynote",
    "longDescription": "Reconstruct PDFs and render Beamer sources directly as vector Keynote slides without an intermediate PDF.",
    "resources": {
      "../keynote_editable_import.applescript": "keynote_editable_import.applescript",
      "resources/fonts/": "fonts/",
      "resources/locales/en.lproj/": "en.lproj/",
      "resources/locales/ko.lproj/": "ko.lproj/",
      "resources/pdfium/LICENSE": "pdfium/LICENSE",
      "resources/pdfium/VERSION": "pdfium/VERSION",
      "resources/pdfium/licenses/": "pdfium/licenses/"
    },
    "macOS": {
      "frameworks": [
        "resources/pdfium/lib/libpdfium.dylib"
      ],
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false
    }
  }
}
